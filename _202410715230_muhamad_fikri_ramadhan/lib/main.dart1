  // ============ PRESTASI ============
  Widget _buildPrestasi() {
    final achievements = [
      ('🏆', 'BUKU AJAR BER-ISBN', 'Mahir Pemrograman WEB',
          'Buku panduan komprehensif pemrograman web modern, arsitektur client-server, dan implementasi basis data.'),
      ('📚', 'BUKU REFERENSI', 'Pengantar Jaringan Komputer',
          'Buku referensi prinsip jaringan komputer, protokol OSI & TCP/IP, routing, dan keamanan transmisi data.'),
      ('📝', 'PUBLIKASI SINTA', 'Metode AHP & WP untuk SPK',
