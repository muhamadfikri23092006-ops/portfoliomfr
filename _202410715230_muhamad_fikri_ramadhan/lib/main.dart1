  }
}

// ============================================================
// IRON MAN PHOTO
// ============================================================
class IronManPhoto extends StatelessWidget {
  final ValueListenable<bool> isIronMode;
  const IronManPhoto({super.key, required this.isIronMode});

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, _) {
        final narrow = MediaQuery.of(context).size.width < 900;
        final w = narrow ? 290.0 : 340.0;
        final h = narrow ? 360.0 : 420.0;

        return ValueListenableBuilder<bool>(
          valueListenable: isIronMode,
          builder: (context, on, _) {
            return AnimatedContainer(
              duration: const Duration(milliseconds: 550),
              curve: Curves.easeOutCubic,
              width: w,
              height: h,
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(26),
                color: const Color(0xFF0D0D14),
                border: Border.all(
                  color: on ? ironGold.withOpacity(0.55) : Colors.white.withOpacity(0.09),
                  width: 1,
                ),
                boxShadow: on
                    ? [
                        const BoxShadow(color: Color(0xB3000000), blurRadius: 80, offset: Offset(0, 30)),
                        BoxShadow(color: ironRed.withOpacity(0.35), blurRadius: 70),
                        BoxShadow(color: ironGold.withOpacity(0.18), blurRadius: 130),
                      ]
                    : [
                        const BoxShadow(color: Color(0x99000000), blurRadius: 70, offset: Offset(0, 30)),
                        BoxShadow(color: cyan.withOpacity(0.06), blurRadius: 60),
                      ],
              ),
              child: ClipRRect(
                borderRadius: BorderRadius.circular(26),
                child: Stack(
                  fit: StackFit.expand,
                  children: [
                    AnimatedScale(
                      duration: const Duration(milliseconds: 800),
                      curve: Curves.easeOutCubic,
                      scale: on ? 1.09 : 1.02,
                      child: ColorFiltered(
                        colorFilter: on
                            ? ColorFilter.matrix(const [
                                1.15, 0, 0, 0, -10,
                                0, 1.15, 0, 0, -10,
                                0, 0, 1.05, 0, -5,
                                0, 0, 0, 1, 0,
                              ])
                            : ColorFilter.matrix(const [
                                0.65, 0.20, 0.15, 0, 0,
                                0.20, 0.65, 0.15, 0, 0,
                                0.20, 0.20, 0.60, 0, 0,
                                0, 0, 0, 1, 0,
                              ]),
                        child: Image.network(
                          'https://i.pravatar.cc/600?img=12',
                          fit: BoxFit.cover,
                          errorBuilder: (_, __, ___) => Container(
                            decoration: const BoxDecoration(
                              gradient: LinearGradient(
                                begin: Alignment.topLeft,
                                end: Alignment.bottomRight,
                                colors: [Color(0xFF101024), Color(0xFF0A0A14)],
                              ),
                            ),
                            child: const Center(
                              child: Icon(Icons.person, color: Colors.white24, size: 100),
                            ),
                          ),
                        ),
                      ),
                    ),
                    AnimatedOpacity(
                      duration: const Duration(milliseconds: 550),
                      opacity: on ? 1 : 0,
                      child: IgnorePointer(
                        child: Container(
                          decoration: BoxDecoration(
                            gradient: RadialGradient(
                              center: const Alignment(0, -0.04),
                              radius: 0.55,
                              colors: [ironRed.withOpacity(0.35), Colors.transparent],
                            ),
                          ),
                        ),
                      ),
                    ),
                    AnimatedOpacity(
                      duration: const Duration(milliseconds: 550),
                      opacity: on ? 1 : 0,
                      child: IgnorePointer(
                        child: Container(
                          decoration: BoxDecoration(
                            gradient: LinearGradient(
                              begin: Alignment.topCenter,
                              end: Alignment.bottomCenter,
                              colors: [
                                ironGold.withOpacity(0.10),
                                Colors.transparent,
                                Colors.transparent,
                                ironRed.withOpacity(0.18),
                              ],
                              stops: const [0.0, 0.40, 0.55, 1.0],
                            ),
                          ),
                        ),
                      ),
                    ),
                    if (on) const _ScanLine(),
                    AnimatedOpacity(
                      duration: const Duration(milliseconds: 500),
                      opacity: on ? 1 : 0,
                      child: Align(
                        alignment: const Alignment(0, 0.16),
                        child: AnimatedScale(
                          duration: const Duration(milliseconds: 600),
                          curve: Curves.easeOutBack,
                          scale: on ? 1.0 : 0.4,
                          child: const _ArcReactor(),
                        ),
                      ),
                    ),
                    Positioned(
                      top: 14, left: 14,
                      child: _HudCorner(isOn: on, top: true, left: true),
                    ),
                    Positioned(
                      top: 14, right: 14,
                      child: _HudCorner(isOn: on, top: true, left: false),
                    ),
                    Positioned(
                      bottom: 14, left: 14,
                      child: _HudCorner(isOn: on, top: false, left: true),
                    ),
                    Positioned(
                      bottom: 14, right: 14,
                      child: _HudCorner(isOn: on, top: false, left: false),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }
}

// ============ SCAN LINE ============
class _ScanLine extends StatefulWidget {
  const _ScanLine();
  @override
  State<_ScanLine> createState() => _ScanLineState();
}

class _ScanLineState extends State<_ScanLine> with SingleTickerProviderStateMixin {
  late final AnimationController _c;
  @override
  void initState() {
    super.initState();
    _c = AnimationController(vsync: this, duration: const Duration(milliseconds: 1900))
      ..repeat();
  }
  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _c,
      builder: (context, _) {
        final t = _c.value;
        final top = -0.08 + 1.16 * t;
        final opacity = t < 0.12
            ? t / 0.12
            : (t > 0.88 ? (1 - t) / 0.12 : 1.0);
        return Align(
          alignment: Alignment(0, 2 * top - 1),
          child: Opacity(
            opacity: opacity.clamp(0.0, 1.0),
            child: Container(
              height: 3,
              decoration: BoxDecoration(
                gradient: const LinearGradient(colors: [
                  Colors.transparent,
                  ironGold,
                  Colors.white,
                  ironGold,
                  Colors.transparent,
                ]),
                boxShadow: [
                  BoxShadow(color: ironGold.withOpacity(0.75), blurRadius: 26, spreadRadius: 6),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}

// ============ ARC REACTOR ============
class _ArcReactor extends StatefulWidget {
  const _ArcReactor();
  @override
  State<_ArcReactor> createState() => _ArcReactorState();
}

class _ArcReactorState extends State<_ArcReactor> with SingleTickerProviderStateMixin {
  late final AnimationController _c;
  @override
  void initState() {
    super.initState();
    _c = AnimationController(vsync: this, duration: const Duration(milliseconds: 2400))
      ..repeat();
  }
  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 74,
      height: 74,
      child: Stack(
        alignment: Alignment.center,
        children: [
          AnimatedBuilder(
            animation: _c,
            builder: (context, _) {
              final t = _c.value;
              return Container(
                width: 74 + 32 * t,
                height: 74 + 32 * t,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  border: Border.all(color: cyan.withOpacity(0.5 * (1 - t)), width: 1),
                ),
              );
            },
          ),
          AnimatedBuilder(
            animation: _c,
            builder: (context, _) {
              final pulse = 1 + 0.12 * math.sin(_c.value * 2 * math.pi);
              return Transform.scale(
                scale: pulse,
                child: Container(
                  width: 74,
                  height: 74,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    gradient: const RadialGradient(
                      colors: [
                        Colors.white,
                        Color(0xFFB8F4FF),
                        cyan,
                        Color(0x4000E5FF),
                        Colors.transparent,
                      ],
                      stops: [0.0, 0.18, 0.40, 0.62, 0.72],
                    ),
                    boxShadow: [
                      BoxShadow(color: cyan.withOpacity(0.85), blurRadius: 26, spreadRadius: 8),
                      BoxShadow(color: cyan.withOpacity(0.35), blurRadius: 60, spreadRadius: 22),
                    ],
                  ),
                ),
              );
            },
          ),
        ],
      ),
    );
  }
}

// ============ HUD CORNER ============
class _HudCorner extends StatelessWidget {
  final bool isOn;
  final bool top, left;
  const _HudCorner({required this.isOn, required this.top, required this.left});

  @override
  Widget build(BuildContext context) {
    return AnimatedOpacity(
      duration: const Duration(milliseconds: 500),
      opacity: isOn ? 1 : 0,
      child: AnimatedSlide(
        duration: const Duration(milliseconds: 600),
        curve: Curves.easeOutBack,
        offset: isOn
            ? Offset.zero
            : Offset(left ? -0.45 : 0.45, top ? -0.45 : 0.45),
        child: Container(
          width: 22,
          height: 22,
          decoration: BoxDecoration(
            border: Border(
              top: top ? const BorderSide(color: ironGold, width: 2) : BorderSide.none,
              bottom: !top ? const BorderSide(color: ironGold, width: 2) : BorderSide.none,
              left: left ? const BorderSide(color: ironGold, width: 2) : BorderSide.none,
              right: !left ? const BorderSide(color: ironGold, width: 2) : BorderSide.none,
            ),
          ),
        ),
      ),
    );
  }
}

// ============================================================
// CUSTOM CURSOR
// ============================================================
class _CustomCursorLayer extends StatefulWidget {
  final Offset pos;
  final ValueListenable<bool> isIron;
  const _CustomCursorLayer({required this.pos, required this.isIron});

  @override
  State<_CustomCursorLayer> createState() => _CustomCursorLayerState();
}

class _CustomCursorLayerState extends State<_CustomCursorLayer>
    with SingleTickerProviderStateMixin {
  late final Ticker _ticker;
  Offset _dot = Offset.zero;
  Offset _glow = Offset.zero;
  late Offset _target;

  @override
  void initState() {
    super.initState();
    _target = widget.pos;
    _dot = widget.pos;
    _glow = widget.pos;
    _ticker = createTicker(_onTick)..start();
  }

  @override
  void didUpdateWidget(covariant _CustomCursorLayer old) {
    super.didUpdateWidget(old);
    _target = widget.pos;
  }

  void _onTick(Duration _) {
    setState(() {
      _dot = Offset.lerp(_dot, _target, 0.35)!;
      _glow = Offset.lerp(_glow, _target, 0.09)!;
    });
  }

  @override
  void dispose() {
    _ticker.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<bool>(
      valueListenable: widget.isIron,
      builder: (context, on, _) {
        return Stack(
          children: [
            Positioned(
              left: _glow.dx - 190,
              top: _glow.dy - 190,
              width: 380,
              height: 380,
              child: Container(
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  gradient: RadialGradient(
                    colors: on
                        ? [ironRed.withOpacity(0.20), ironGold.withOpacity(0.08), Colors.transparent]
                        : [cyan.withOpacity(0.13), cyan.withOpacity(0.05), Colors.transparent],
                    stops: const [0.0, 0.35, 0.7],
                  ),
                ),
              ),
            ),
            Positioned(
              left: _dot.dx - 4,
              top: _dot.dy - 4,
              child: Container(
                width: 8,
                height: 8,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: on ? ironGold : Colors.white,
                  boxShadow: on
                      ? [
                          BoxShadow(color: ironGold.withOpacity(0.7), blurRadius: 22, spreadRadius: 6),
                          BoxShadow(color: ironRed.withOpacity(0.4), blurRadius: 60, spreadRadius: 16),
                        ]
                      : [
                          BoxShadow(color: Colors.white.withOpacity(0.55), blurRadius: 18, spreadRadius: 4),
                          BoxShadow(color: cyan.withOpacity(0.25), blurRadius: 40, spreadRadius: 10),
                        ],
                ),
              ),
            ),
          ],
        );
      },
    );
  }
}

// ============================================================
// GRID + VIGNETTE BACKGROUND
// ============================================================
class GridPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    // 1) Mask radial untuk grid (memudar ke tepi)
    canvas.saveLayer(Offset.zero & size, Paint());

    final gridPaint = Paint()
      ..color = cyan.withOpacity(0.045)
      ..strokeWidth = 1;

    const step = 55.0;
    for (double x = 0; x <= size.width; x += step) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), gridPaint);
    }
    for (double y = 0; y <= size.height; y += step) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }

    final maskCenter = Offset(size.width * 0.5, size.height * 0.3);
    final maskRadius = math.sqrt(size.width * size.width + size.height * size.height) * 0.5;
    final maskPaint = Paint()
      ..shader = const RadialGradient(
        colors: [Colors.black, Colors.transparent],
        stops: [0.0, 0.80],
      ).createShader(Rect.fromCircle(center: maskCenter, radius: maskRadius))
      ..blendMode = BlendMode.dstIn;
    canvas.drawRect(Offset.zero & size, maskPaint);
    canvas.restore();

    // 2) Vignette gelap di tepi layar
    final vCenter = Offset(size.width / 2, size.height / 2);
    final vRadius = math.max(size.width, size.height) * 0.85;
    final vignettePaint = Paint()
      ..shader = RadialGradient(
        colors: [Colors.transparent, Colors.black.withOpacity(0.85)],
        stops: const [0.40, 1.0],
      ).createShader(Rect.fromCircle(center: vCenter, radius: vRadius));
    canvas.drawRect(Offset.zero & size, vignettePaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}