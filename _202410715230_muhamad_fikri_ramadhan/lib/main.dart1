import 'dart:math' as math;
import 'package:flutter/gestures.dart';
import 'package:flutter/material.dart';
import 'package:flutter/scheduler.dart';
import 'package:flutter/services.dart';

// ============ COLORS (sama persis HTML) ============
const bg           = Color(0xFF07070B);
const bgAlt        = Color(0xFF0B0B12);
const cardColor    = Color(0x08FFFFFF);
const borderColor  = Color(0x14FFFFFF);
const textPrimary  = Color(0xFFE7EAF0);
const textMuted    = Color(0xFF7C8291);
const cyan         = Color(0xFF00E5FF);
const purple       = Color(0xFF7C5CFF);
const ironRed      = Color(0xFFFF2D2D);
const ironGold     = Color(0xFFFFB700);
const green        = Color(0xFF22E07A);

// ============ MAIN ============
void main() {
  WidgetsFlutterBinding.ensureInitialized();
  SystemChrome.setSystemUIOverlayStyle(
    const SystemUiOverlayStyle(
      statusBarColor: Colors.transparent,
      statusBarIconBrightness: Brightness.light,
      systemNavigationBarColor: bg,
      systemNavigationBarIconBrightness: Brightness.light,
    ),
  );
  runApp(const PortfolioApp());
}

class PortfolioApp extends StatelessWidget {
  const PortfolioApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Fried Sinlae — Portfolio',
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: bg,
        colorScheme: const ColorScheme.dark(
          primary: cyan,
          secondary: purple,
          surface: bgAlt,
        ),
        useMaterial3: true,
      ),
      home: const PortfolioPage(),
    );
  }
}

// ============ MAIN PAGE ============
class PortfolioPage extends StatefulWidget {
  const PortfolioPage({super.key});
  @override
  State<PortfolioPage> createState() => _PortfolioPageState();
}

class _PortfolioPageState extends State<PortfolioPage> {
  final _scroll = ScrollController();
  final _keys = List.generate(6, (_) => GlobalKey());
  final _mousePos = ValueNotifier<Offset?>(null);
  final _ironMode = ValueNotifier<bool>(false);
  final _activeNav = ValueNotifier<int>(0);
  final _photoKey = GlobalKey();
  final _headerScrolled = ValueNotifier<bool>(false);

  final _sections = ['Home', 'About', 'Karir', 'Prestasi', 'Projects', 'Contact'];

  @override
  void initState() {
    super.initState();
    _scroll.addListener(_onScroll);
  }

  void _onScroll() {
    _headerScrolled.value = _scroll.offset > 20;
    for (int i = _keys.length - 1; i >= 0; i--) {
      final ctx = _keys[i].currentContext;
      if (ctx != null) {
        final box = ctx.findRenderObject() as RenderBox?;
        if (box != null && box.hasSize) {
          final pos = box.localToGlobal(Offset.zero);
          if (pos.dy < 250) {
            _activeNav.value = i;
            return;
          }
        }
      }
    }
  }

  void _goTo(int i) {
    final ctx = _keys[i].currentContext;
    if (ctx != null) {
      Scrollable.ensureVisible(ctx,
          duration: const Duration(milliseconds: 600),
          curve: Curves.easeInOut,
          alignment: 0.02);
    }
  }

  void _onHover(PointerHoverEvent e) {
    _mousePos.value = e.position;
    final box = _photoKey.currentContext?.findRenderObject() as RenderBox?;
    if (box != null) {
      final center = box.localToGlobal(box.size.center(Offset.zero));
      final dist = (e.position - center).distance;
      _ironMode.value = dist < 280;
    }
  }

  @override
  void dispose() {
    _scroll.dispose();
    _scroll.removeListener(_onScroll);
    _mousePos.dispose();
    _ironMode.dispose();
    _activeNav.dispose();
    _headerScrolled.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Listener(
          onPointerHover: _onHover,
          child: MouseRegion(
            cursor: SystemMouseCursors.none,
            child: Stack(
              children: [
                Positioned.fill(
                  child: IgnorePointer(child: CustomPaint(painter: GridPainter())),
                ),
                Column(
                  children: [
                    _buildHeader(),
                    Expanded(
                      child: SingleChildScrollView(
                        controller: _scroll,
                        physics: const BouncingScrollPhysics(),
                        child: Column(
                          children: [
                            _buildHero(),
                            _buildAbout(),
                            _buildCareer(),
                            _buildPrestasi(),
                            _buildProjects(),
                            _buildContact(),
                            _buildFooter(),
                          ],
                        ),
                      ),
                    ),
                  ],
                ),
                ValueListenableBuilder<Offset?>(
                  valueListenable: _mousePos,
                  builder: (context, pos, _) {
                    if (pos == null) return const SizedBox.shrink();
                    return Positioned.fill(
                      child: IgnorePointer(
                        child: _CustomCursorLayer(pos: pos, isIron: _ironMode),
                      ),
                    );
                  },
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  // ============ HEADER ============
  Widget _buildHeader() {
    return ValueListenableBuilder<bool>(
      valueListenable: _headerScrolled,
      builder: (context, scrolled, _) {
        return Container(
          padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 14),
          decoration: BoxDecoration(
            color: scrolled ? const Color(0xF207070B) : Colors.transparent,
            border: Border(
              bottom: BorderSide(color: scrolled ? borderColor : Colors.transparent),
            ),
          ),
          child: LayoutBuilder(
            builder: (context, c) {
              final wide = c.maxWidth > 700;
              return Row(
                children: [
                  const Text('◆ ',
                      style: TextStyle(fontSize: 15, color: Colors.white, fontWeight: FontWeight.w700)),
                  const Text('FRIED',
                      style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700,
                          letterSpacing: 3, color: Colors.white)),
                  const Text('.KU',
                      style: TextStyle(fontSize: 15, fontWeight: FontWeight.w700,
                          letterSpacing: 3, color: cyan,
                          shadows: [Shadow(color: cyan, blurRadius: 12)])),
                  const Spacer(),
                  if (wide)
                    ValueListenableBuilder<int>(
                      valueListenable: _activeNav,
                      builder: (context, active, _) {
                        return Row(
                          children: List.generate(_sections.length, (i) {
                            final isActive = i == active;
                            return Padding(
                              padding: const EdgeInsets.only(left: 4),
                              child: TextButton(
                                onPressed: () => _goTo(i),
                                child: Text(_sections[i],
                                    style: TextStyle(
                                      fontSize: 13,
                                      fontWeight: FontWeight.w500,
                                      letterSpacing: 0.5,
                                      color: isActive ? Colors.white : textMuted,
                                    )),
                              ),
                            );
                          }),
                        );
                      },
                    )
                  else
                    PopupMenuButton<int>(
                      icon: const Icon(Icons.menu, color: cyan, size: 22),
                      color: bgAlt,
                      onSelected: _goTo,
                      itemBuilder: (context) => List.generate(
                        _sections.length,
                        (i) => PopupMenuItem(
                          value: i,
                          child: Text(_sections[i],
                              style: TextStyle(
                                color: i == 0 ? cyan : textMuted,
                                fontSize: 14,
                              )),
                        ),
                      ),
                    ),
                ],
              );
            },
          ),
        );
      },
    );
  }

  // ============ HERO ============
  Widget _buildHero() {
    return Container(
      key: _keys[0],
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 40),
      constraints: const BoxConstraints(maxWidth: 1200),
      child: LayoutBuilder(
        builder: (context, c) {
          final wide = c.maxWidth > 850;

          final textCol = Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(100),
                  border: Border.all(color: cyan.withOpacity(0.3)),
                  color: cyan.withOpacity(0.06),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Container(
                      width: 7, height: 7,
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        color: green,
                        boxShadow: [BoxShadow(color: green, blurRadius: 10)],
                      ),
                    ),
                    const SizedBox(width: 8),
                    const Text('Tersedia untuk kolaborasi',
                        style: TextStyle(fontSize: 12, color: Color(0xFF9FE9F5), letterSpacing: 0.6)),
                  ],
                ),
              ),
              const SizedBox(height: 24),
              Text.rich(
                TextSpan(children: [
                  const TextSpan(text: 'Halo, aku '),
                  TextSpan(
                    text: 'Fried Sinlae',
                    style: TextStyle(
                      foreground: Paint()
                        ..shader = const LinearGradient(colors: [cyan, purple, ironRed])
                            .createShader(const Rect.fromLTWH(0, 0, 400, 60)),
                    ),
                  ),
                ]),
                style: TextStyle(
                  fontSize: wide ? 58 : 34,
                  fontWeight: FontWeight.w800,
                  letterSpacing: -2,
                  height: 1.06,
                  color: textPrimary,
                ),
              ),
              const SizedBox(height: 18),
              const Text('Senior Data Engineer & Dosen',
                  style: TextStyle(fontSize: 17, color: Color(0xFFB9BFCC), fontWeight: FontWeight.w500)),
              const SizedBox(height: 20),
              const Text(
                'Membangun arsitektur data enterprise, mengajar generasi masa depan, '
                'dan meneliti teknologi informasi untuk solusi nyata.',
                style: TextStyle(fontSize: 15, color: textMuted, height: 1.75),
              ),
              const SizedBox(height: 32),
              Wrap(
                spacing: 12, runSpacing: 12,
                children: [
                  ElevatedButton(
                    onPressed: () => _goTo(4),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: cyan,
                      foregroundColor: bg,
                      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                      elevation: 0,
                    ),
                    child: const Text('Lihat Karya →',
                        style: TextStyle(fontWeight: FontWeight.w700, fontSize: 14)),
                  ),
                  OutlinedButton(
                    onPressed: () => _goTo(5),
                    style: OutlinedButton.styleFrom(
                      foregroundColor: Colors.white,
                      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
                      side: const BorderSide(color: borderColor),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    ),
                    child: const Text('Hubungi Aku',
                        style: TextStyle(fontWeight: FontWeight.w600, fontSize: 14)),
                  ),
                ],
              ),
              const SizedBox(height: 40),
              _buildStatsRow(),
            ],
          );

          final photoCol = Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              IronManPhoto(key: _photoKey, isIronMode: _ironMode),
              const SizedBox(height: 18),
              ValueListenableBuilder<bool>(
                valueListenable: _ironMode,
                builder: (context, on, _) {
                  return AnimatedDefaultTextStyle(
                    duration: const Duration(milliseconds: 300),
                    style: TextStyle(
                      fontSize: 12.5,
                      letterSpacing: 0.8,
                      color: on ? ironGold : const Color(0xFF5E6473),
                      shadows: on
                          ? [Shadow(color: ironGold.withOpacity(0.65), blurRadius: 16)]
                          : null,
                    ),
                    child: Text(on
                        ? '⚡ Mode: IRON MAN aktif'
                        : 'Sentuh atau dekatkan kursor ke fotoku 👆'),
                  );
                },
              ),
            ],
          );

          if (!wide) {
            return Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [textCol, const SizedBox(height: 40), photoCol],
            );
          }
          return Row(
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              Expanded(flex: 11, child: textCol),
              const SizedBox(width: 60),
              Expanded(flex: 9, child: photoCol),
            ],
          );
        },
      ),
    );
  }

  Widget _buildStatsRow() {
    final stats = [
      ('10+', 'Tahun Pengalaman'),
      ('48+', 'Proyek Selesai'),
      ('15+', 'Publikasi & Buku'),
      ('500+', 'Mahasiswa'),
    ];
    return LayoutBuilder(
      builder: (context, c) {
        final wide = c.maxWidth > 500;
        return Container(
          padding: const EdgeInsets.all(24),
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: borderColor),
            gradient: LinearGradient(
              colors: [Colors.white.withOpacity(0.03), Colors.white.withOpacity(0.01)],
            ),
          ),
          child: GridView.count(
            crossAxisCount: wide ? 4 : 2,
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            crossAxisSpacing: 16,
            mainAxisSpacing: 20,
            childAspectRatio: wide ? 1.6 : 2.0,
            children: stats.map((s) => Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                ShaderMask(
                  shaderCallback: (bounds) =>
                      const LinearGradient(colors: [Colors.white, cyan]).createShader(bounds),
                  child: Text(s.$1,
                      style: const TextStyle(
                          fontSize: 30,
                          fontWeight: FontWeight.w800,
                          letterSpacing: -1,
                          color: Colors.white)),
                ),
                const SizedBox(height: 4),
                Text(s.$2,
                    style: const TextStyle(fontSize: 12, color: textMuted, letterSpacing: 0.5)),
              ],
            )).toList(),
          ),
        );
      },
    );
  }

  // ============ SECTION HEADER HELPER ============
  Widget _sectionHeader(String eyebrow, String title, String sub) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Container(
              width: 22, height: 2, color: cyan,
              boxShadow: [BoxShadow(color: cyan, blurRadius: 10)],
            ),
            const SizedBox(width: 10),
            Text(eyebrow.toUpperCase(),
                style: const TextStyle(
                    fontSize: 12, letterSpacing: 3, color: cyan, fontWeight: FontWeight.w600)),
          ],
        ),
        const SizedBox(height: 16),
        Text(title,
            style: const TextStyle(
                fontSize: 32,
                fontWeight: FontWeight.w800,
                letterSpacing: -1.2,
                height: 1.15,
                color: textPrimary)),
        const SizedBox(height: 12),
        Text(sub, style: const TextStyle(fontSize: 15, color: textMuted)),
      ],
    );
  }

  // ============ ABOUT ============
  Widget _buildAbout() {
    return Container(
      key: _keys[1],
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 60),
      constraints: const BoxConstraints(maxWidth: 1200),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _sectionHeader('Tentang', 'Kenalan lebih dekat',
              'Sedikit cerita tentang siapa aku dan apa yang aku kerjakan.'),
          const SizedBox(height: 40),
          LayoutBuilder(
            builder: (context, c) {
              final wide = c.maxWidth > 800;
              final aboutText = Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text.rich(
                    TextSpan(children: [
                      const TextSpan(text: 'Aku ', style: TextStyle(color: Color(0xFF9AA0AD))),
                      const TextSpan(text: 'Fried Sinlae',
                          style: TextStyle(color: Colors.white, fontWeight: FontWeight.w600)),
                      const TextSpan(text: ', seorang ', style: TextStyle(color: Color(0xFF9AA0AD))),
                      const TextSpan(text: 'Senior Data Engineer',
                          style: TextStyle(color: Colors.white, fontWeight: FontWeight.w600)),
                      const TextSpan(text: ' sekaligus ', style: TextStyle(color: Color(0xFF9AA0AD))),
                      const TextSpan(text: 'Dosen',
                          style: TextStyle(color: Colors.white, fontWeight: FontWeight.w600)),
                      const TextSpan(text: ' di Fakultas Ilmu Komputer, Universitas Bhayangkara Jakarta Raya.',
                          style: TextStyle(color: Color(0xFF9AA0AD))),
                    ]),
                    style: const TextStyle(fontSize: 15, height: 1.85),
                  ),
                  const SizedBox(height: 16),
                  const Text(
                    'Selama lebih dari 10 tahun, aku membantu perusahaan membangun arsitektur data, '
                    'mengajar generasi developer masa depan, dan meneliti solusi teknologi informasi.',
                    style: TextStyle(fontSize: 15, color: Color(0xFF9AA0AD), height: 1.85),
                  ),
                  const SizedBox(height: 16),
                  const Text(
                    'Aku percaya bahwa detail kecil — pemahaman domain, kualitas kode, dan pengalaman pengguna — '
                    'adalah yang membuat sebuah solusi teknologi benar-benar berdampak.',
                    style: TextStyle(fontSize: 15, color: Color(0xFF9AA0AD), height: 1.85),
                  ),
                ],
              );

              final skills = Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  _skillGroup('Data & AI', ['Data Engineering', 'Python', 'SQL', 'ETL/ELT', 'Machine Learning']),
                  _skillGroup('Software Dev', ['Laravel', 'PHP', 'Flutter', 'JavaScript', 'MySQL']),
                  _skillGroup('Tools & Infra', ['Docker', 'Git', 'Linux CLI', 'PostgreSQL', 'VMware']),
                ],
              );

              if (!wide) {
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [aboutText, const SizedBox(height: 30), skills],
                );
              }
              return Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Expanded(child: aboutText),
                  const SizedBox(width: 60),
                  Expanded(child: skills),
                ],
              );
            },
          ),
        ],
      ),
    );
  }

  Widget _skillGroup(String title, List<String> skills) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 26),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(title.toUpperCase(),
              style: const TextStyle(
                  fontSize: 12, letterSpacing: 2.4, color: cyan, fontWeight: FontWeight.w600)),
          const SizedBox(height: 12),
          Wrap(
            spacing: 8, runSpacing: 8,
            children: skills
                .map((s) => Container(
                      padding: const EdgeInsets.symmetric(horizontal: 13, vertical: 7),
                      decoration: BoxDecoration(
                        color: Colors.white.withOpacity(0.03),
                        borderRadius: BorderRadius.circular(100),
                        border: Border.all(color: borderColor),
                      ),
                      child: Text(s,
                          style: const TextStyle(
                              fontSize: 12.5, color: Color(0xFFB8BECC), fontWeight: FontWeight.w500)),
                    ))
                .toList(),
          ),
        ],
      ),
    );
  }

